# copy to .env.local

# postgres (neon). empty = in-memory store, fine for a local demo, gone on restart.
# after setting it run: npm run db:setup
DATABASE_URL=

# robot sends "Authorization: Bearer <token>" - same value as teamInbox.token in robot-app/local.properties
TEAM_INBOX_TOKEN=

# teams "Workflows" incoming webhook of the practice channel. used for doctors without their own webhook and for help requests
TEAMS_WEBHOOK_URL=

# secret in the "Call patient in" link of the teams card. any long random string
CALL_KEY=

# address that phones and teams can reach, e.g. https://nova-clinic.vercel.app or http://192.168.2.214:3000
# empty = the address the robot used to reach this server
PUBLIC_BASE_URL=

# optional: password for the dashboard pages and dashboard apis (basic auth, any user name)
DASHBOARD_PASSWORD=

# secret in the url of the IoT hook (/api/iot/hook/<IOT_KEY>) that the portal's IoT Device Center calls. short, url-safe
IOT_KEY=

# optional: time zone for clock times in teams cards when the server runs in UTC, e.g. Europe/Berlin
CLINIC_TIMEZONE=

# optional: map spot where nova waits, offered first under "Send to" on the board. empty = Reception Point
ROBOT_HOME_SPOT=
