# copy to .env.local (local) or set them in the Vercel project (deploy)

# postgres (neon). empty = this laptop keeps everything in memory plus a copy in a file (STORE_FILE).
# after setting it run: npm run db:setup (again after every update, it only adds what is missing)
DATABASE_URL=

# without DATABASE_URL: the json file with places, channels, settings and open walks (default .data/store.json,
# git-ignored, it holds the channel secrets). off = memory only, gone after a restart
STORE_FILE=

# robot sends "Authorization: Bearer <token>" - same value as teamInbox.token in robot-app/local.properties
TEAM_INBOX_TOKEN=

# staff password for the dashboard (/login). empty = no login (only on your own laptop)
DASHBOARD_PASSWORD=

# optional: extra secret mixed into the session cookie signature. changing it signs everybody out
SESSION_SECRET=

# secret in the links of the teams card buttons ("Call in", "Done - guide to exit"). any long random string
CALL_KEY=

# teams "Workflows" incoming webhook of the practice channel. used for places without their own webhook and for help requests.
# slack, telegram, whatsapp, discord, email and own webhooks are set up on the /notifications page, not here
TEAMS_WEBHOOK_URL=

# address that phones and teams can open, e.g. https://nova-clinic.vercel.app or http://192.168.2.214:3000
# empty = the address the request came in on
PUBLIC_BASE_URL=

# time zone of the clinic, for tickets per day, today's numbers and clock times in cards, e.g. Europe/Berlin.
# set it on vercel, the server runs in UTC there
CLINIC_TIMEZONE=

# email as a second channel next to teams (resend.com, plain rest call). places with an email address get
# the same message as the teams card: ticket and room, never a name. both empty = no email
RESEND_API_KEY=
# sender, e.g. Nova Clinic <otto@your-domain.example> (the domain must be verified at resend)
EMAIL_FROM=

# key for the nurse's system: POST /api/integrations/journeys with header X-Api-Key. empty = route off
INTEGRATION_KEY=

# optional: how long one notification channel may take in ms (default 8000)
NOTIFY_TIMEOUT_MS=
