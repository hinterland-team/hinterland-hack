<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- lets this app hand an apk to the system installer; the system still shows the Install prompt -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- RobotApi (chassis motion for arrow-key driving) - same as the clinic app -->
    <uses-permission android:name="com.ainirobot.coreservice.robotSettingProvider" />

    <!-- RobotApi binds to this package; needed for package visibility on android 11+ -->
    <queries>
        <package android:name="com.ainirobot.coreservice" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <!-- cleartext is on so the laptop can reach the http server over plain local wifi -->
    <application
        android:name=".RemoteApp"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:usesCleartextTraffic="true">

        <!-- no screenOrientation: OrionStar's rule, the robot screen is landscape anyway -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- lets the robot pick this app as its boot app (settings - developer settings - boot app) -->
            <intent-filter>
                <action android:name="action.orionstar.default.app" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- holds the lan server + screen capture while the app runs; android keeps it alive -->
        <service
            android:name=".RemoteService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- taps/swipes/text from the laptop go through this; the dev switches it on in
             Settings - Accessibility. it is off until then, so it cannot act on its own. -->
        <service
            android:name=".RemoteAccessibilityService"
            android:exported="false"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_a11y" />
        </service>

        <!-- hands uploaded apks to the system installer by a content:// uri -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/remote_file_paths" />
        </provider>

    </application>

</manifest>
